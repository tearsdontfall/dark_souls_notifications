<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.knolss.meetings-watcher</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/Dark Souls Meetings.app/Contents/MacOS/Dark Souls Meetings</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/meetings-watcher.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/meetings-watcher.err</string>
</dict>
</plist>
